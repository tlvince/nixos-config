{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":rebaseStalePrs",
    ":semanticCommits"
  ],
  "minimumReleaseAge": "3 days",
  "constraints": {
    "ghActionsLock": "v0.4.1"
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "\\.github/scripts/patch-nixpkgs\\.sh$"
      ],
      "matchStrings": [
        "ghcherry==(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "ghcherry",
      "datasourceTemplate": "pypi"
    }
  ]
}
