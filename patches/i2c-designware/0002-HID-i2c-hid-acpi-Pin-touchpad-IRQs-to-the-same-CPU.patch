+/*
+ * Align the IRQ affinity of the touchpad GPIO IRQ and the I2C controller
+ * IRQ so that both are serviced on the same CPU. When they land on
+ * different cores, each touchpad event wakes two separate power domains,
+ * increasing power consumption by ~2W on Framework Laptops.
+ *
+ * The touchpad's GPIO IRQ (client->irq) is used as the reference; the I2C
+ * controller's IRQ is pinned to the same single CPU so that both wakeups
+ * hit the same core.
+ */
+static void i2c_hid_acpi_align_irq_affinity(struct i2c_client *client)
+{
+	struct device *parent = client->adapter->dev.parent;
+	struct irq_desc *desc;
+	unsigned int best_cpu = nr_cpu_ids, best_cnt = 0;
+	unsigned int cpu;
+	int i2c_irq;
+
+	if (!parent || !dev_is_platform(parent))
+		return;
+
+	i2c_irq = platform_get_irq_optional(to_platform_device(parent), 0);
+	if (i2c_irq < 0)
+		return;
+
+	/*
+	 * The touchpad GPIO IRQ (pinctrl-amd) does not implement
+	 * irq_set_affinity and its effective_affinity mask is empty,
+	 * so we cannot read or set its affinity directly.  Instead,
+	 * find the CPU where it is actually being delivered by reading
+	 * the per-CPU interrupt counts accumulated during probe (the
+	 * reset-completion IRQ has already fired by the time
+	 * i2c_hid_core_probe() returns), then pin the I2C controller
+	 * IRQ to that same CPU so both wakeups hit a single core.
+	 */
+	desc = irq_data_to_desc(irq_get_irq_data(client->irq));
+	if (!desc || !desc->kstat_irqs)
+		return;
+
+	for_each_online_cpu(cpu) {
+		unsigned int cnt = irq_desc_kstat_cpu(desc, cpu);
+		if (cnt > best_cnt) {
+			best_cnt = cnt;
+			best_cpu = cpu;
+		}
+	}
+
+	if (best_cpu >= nr_cpu_ids || best_cnt == 0)
+		return;
+
+	irq_set_affinity(i2c_irq, cpumask_of(best_cpu));
+}
+
 static int i2c_hid_acpi_probe(struct i2c_client *client)
 {
 	struct device *dev = &client->dev;
@@ -112,8 +170,14 @@ static int i2c_hid_acpi_probe(struct i2c_client *client)
 
 	acpi_device_fix_up_power(ihid_acpi->adev);
 
-	return i2c_hid_core_probe(client, &ihid_acpi->ops,
+	ret = i2c_hid_core_probe(client, &ihid_acpi->ops,
 				  hid_descriptor_address, 0);
+	if (ret)
+		return ret;
+
+	i2c_hid_acpi_align_irq_affinity(client);
+
+	return 0;
 }
 
