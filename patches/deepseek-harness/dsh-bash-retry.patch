+async function markerSession(): Promise<{
+  ctx: Context
+  session: ReturnType<SessionStore['prepare']>
+  unregister: () => void
+}> {
+  const ctx = new Context()
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  const unregister = ctx.tools.register(defineContentToolFixture({
+    name: 'bash',
+    description: 'mock bash for auto-retry tests',
+    parameters: { command: { type: 'string' } },
+    async execute(args: { command: string }) {
+      return [{ type: 'text', text: `ran: ${args.command}` }]
+    },
+  }))
+
+  const seed: SessionEvent[] = [
+    { type: 'turn/start', seq: 0, time: 1, data: { turn: 1 } },
+    { type: 'step/start', seq: 1, time: 2, data: { turn: 1, step: 1 } },
+    {
+      type: 'assistant/message', seq: 2, time: 3, data: {
+        turn: 1, step: 1,
+        message: createMessage({
+          role: 'assistant',
+          content: [
+            { type: 'tool-call', id: CallId('call-1'), name: 'bash', arguments: '{"command":"sleep 1"}' },
+          ],
+          source: { kind: 'model', provider: 'mock', model: 'mock' },
+        }),
+      },
+      surfaceOp: 'append',
+    },
+    { type: 'tool/call', seq: 3, time: 4, data: { turn: 1, step: 1, callId: CallId('call-1'), name: 'bash', arguments: '{"command":"sleep 1"}' } },
+    {
+      type: 'tool/result', seq: 4, time: 5, data: {
+        turn: 1, step: 1,
+        message: {
+          id: 'interrupted-tool-result-call-1-5' as never,
+          role: 'user',
+          source: { kind: 'tool', callId: CallId('call-1') },
+          content: [{
+            type: 'tool-result',
+            toolCallId: CallId('call-1'),
+            isError: false,
+            content: [{ type: 'text', text: AUTO_RETRY_MARKER }],
+          }],
+        },
+      },
+      surfaceOp: 'append',
+      sourceEventSeqs: [3],
+    },
+    { type: 'step/end', seq: 5, time: 6, data: { turn: 1, step: 1 } },
+    { type: 'turn/end', seq: 6, time: 7, data: { turn: 1, reason: { kind: 'interrupted' } } },
+  ]
+
+  const session = ctx.sessions.prepare(SessionId('auto-retry-fixture'), { seed, meta: { cwd: '/tmp' } })
+  return { ctx, session, unregister }
+}
+
+/** First text block of the current surface tool/result, if any. */
+function currentResultText(session: ReturnType<SessionStore['prepare']>): string | undefined {
+  const resultEvent = session.surface.nodes.find(seq => {
+    const e = session.events[seq]
+    return e?.type === 'tool/result'
+  })
+  if (resultEvent === undefined) return undefined
+  const event = session.events[resultEvent]
+  if (event?.type !== 'tool/result') return undefined
+  const first = event.data.message.content[0]
+  if (first?.type !== 'tool-result') return undefined
+  const text = first.content[0]
+  return text?.type === 'text' ? text.text : undefined
+}
+
+describe('autoRetryInterruptedCalls', () => {
+  it('replaces a repair marker with the re-run result before the model sees it', async () => {
+    const { ctx, session, unregister } = await markerSession()
+    // The marker is on the model-visible surface before the retry.
+    const markerSeq = session.surface.nodes.find(seq => session.events[seq]?.type === 'tool/result')
+    expect(markerSeq).toBe(4)
+
+    await autoRetryInterruptedCalls(
+      ctx,
+      { id: session.id } as never,
+      session,
+      new AbortController().signal,
+    )
+    unregister()
+
+    expect(currentResultText(session)).toBe('ran: sleep 1')
+    // The replacement shadowed the marker node: it is no longer on the surface.
+    expect(session.surface.nodes).not.toContain(4)
+  })
+
+  it('leaves the surface unchanged when no marker is present', async () => {
+    const { ctx, session, unregister } = await markerSession()
+    // Drain the marker by replacing it once, then a second pass must be a no-op.
+    await autoRetryInterruptedCalls(
+      ctx,
+      { id: session.id } as never,
+      session,
+      new AbortController().signal,
+    )
+    const nodesAfter = [...session.surface.nodes]
+    await autoRetryInterruptedCalls(
+      ctx,
+      { id: session.id } as never,
+      session,
+      new AbortController().signal,
+    )
+    unregister()
+    expect([...session.surface.nodes]).toEqual(nodesAfter)
+  })
+
+  it('surfaces the re-dispatch failure text when the tool is no longer registered', async () => {
+    const { ctx, session, unregister } = await markerSession()
+    // Unregister the fixture so the re-dispatch yields an unknown-tool result.
+    unregister()
+    await autoRetryInterruptedCalls(
+      ctx,
+      { id: session.id } as never,
+      session,
+      new AbortController().signal,
+    )
+    expect(currentResultText(session)).toContain('unknown tool "bash"')
+  })
+
+  it('does not re-dispatch a marker already rewritten to the attempted state (loop breaker)', async () => {
+    const { ctx, session, unregister } = await markerSession()
+    // Simulate a re-dispatch whose command killed the harness before its result
+    // landed: the durable marker was already rewritten to a non-matchable text
+    // (the auto-retry claims the marker BEFORE dispatching). A resumed session
+    // must therefore find nothing to retry — otherwise `systemctl restart
+    // dsh-web`-style commands would loop forever.
+    const markerSeq = 4
+    const marker = session.events[markerSeq]
+    expect(marker?.type === 'tool/result').toBe(true)
+    if (marker?.type !== 'tool/result') throw new Error('missing marker fixture')
+    const result = marker.data.message.content[0]
+    if (result?.type !== 'tool-result') throw new Error('missing tool-result block')
+    session.append('tool/result', {
+      ...marker.data,
+      message: {
+        ...marker.data.message,
+        content: [{
+          ...result,
+          content: [{ type: 'text', text: 'The harness attempted to retry this interrupted tool call, but the retry was itself interrupted.' }],
+        }] as [typeof result],
+      },
+    }, {
+      surfaceOp: { op: 'replace', start: markerSeq, end: markerSeq },
+      sourceEventSeqs: [markerSeq],
+    })
+    unregister() // any re-dispatch would now fail loudly
+    await autoRetryInterruptedCalls(
+      ctx,
+      { id: session.id } as never,
+      session,
+      new AbortController().signal,
+    )
+    // The attempted-state text remains exactly as written — no re-dispatch, no
+    // further replacement, and the tool registry was never consulted again.
+    expect(currentResultText(session)).toBe(
+      'The harness attempted to retry this interrupted tool call, but the retry was itself interrupted.',
+    )
+  })
+
+  it('detects pending auto-retry markers via hasPendingAutoRetry', async () => {
+    const { ctx, session, unregister } = await markerSession()
+    expect(hasPendingAutoRetry(session)).toBe(true)
+    // After running the retry, the marker is gone — no more pending retries.
+    await autoRetryInterruptedCalls(
+      ctx,
+      { id: session.id } as never,
+      session,
+      new AbortController().signal,
+    )
+    unregister()
+    expect(hasPendingAutoRetry(session)).toBe(false)
+  })
+})
+
+describe('session integration', () => {
+  it('keeps a live user message alongside the retried marker without invalidating the surface', async () => {
+    const { ctx, session, unregister } = await markerSession()
+    // Simulate the resumed turn appending a prompt after the repair closers.
+    session.append('user/message', createUserMessage({
+      content: [{ type: 'text', text: 'continue' }],
+      source: { kind: 'user' },
+    }), { surfaceOp: 'append' })
+    await autoRetryInterruptedCalls(
+      ctx,
+      { id: session.id } as never,
+      session,
+      new AbortController().signal,
+    )
+    unregister()
+    // The surface still holds the appended prompt and the replacement result.
+    const messages = session.deriveMessages()
+    const promptTexts = messages.flatMap(m => m.content.flatMap(b => b.type === 'text' ? [b.text] : []))
+    const resultTexts = messages.flatMap(m =>
+      m.content.flatMap(b => b.type === 'tool-result'
+        ? b.content.flatMap(c => c.type === 'text' ? [c.text] : [])
+        : []))
+    expect(promptTexts).toContain('continue')
+    expect(resultTexts).toContain('ran: sleep 1')
+  })
+})
