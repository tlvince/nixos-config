--- /dev/null
+++ b/packages/core/agent-loop/src/auto-retry.ts
+++ /tmp/dsh-full/packages/core/agent-loop/src/auto-retry.ts	2026-09-01 12:27:45.112173930 +0100
@@ -0,0 +1,182 @@
+/**
+ * Automatic retry of interrupted auto-retryable tool calls (bash) after a
+ * crash-recovery repair. Each bash invocation is a fresh subprocess, so a
+ * repair marker left by `interruptedTurnClosers` can be re-dispatched safely:
+ * the resumed loop re-runs the exact recorded command and surface-replaces the
+ * marker with the real result before the model ever sees it.
+ *
+ * The replacement obeys the session's tool-result rewrite rule: it preserves
+ * every field of the marker event except the text content, so the model-visible
+ * surface shows a completed call instead of an ambiguous interruption error.
+ *
+ * LOOP BREAKER: the marker is rewritten to a non-matchable "attempted" state
+ * BEFORE the command is re-dispatched. If the re-run itself is interrupted
+ * (e.g. the recorded command restarts the harness that is executing it), the
+ * durable log keeps the attempted text rather than a fresh auto-retry marker,
+ * so a later resume never retries the same call a second time. This makes the
+ * auto-retry effectively one-shot per interrupted call, preventing a retry
+ * loop for self-restarting commands such as `systemctl restart dsh-web`.
+ * @module dsh-agent-loop/auto-retry
+ */
+
+import type { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import type { Session, SessionEvent } from '@deepseek-ai/dsh-session'
+import { AUTO_RETRY_MARKER } from '@deepseek-ai/dsh-session'
+import { freezeMessage, type ToolResultMessage } from '@deepseek-ai/dsh-llm'
+
+/**
+ * Merge-extensible message source for a harness-initiated continuation after
+ * an automatic retry. The goal round driver adds its own `goal` kind through
+ * the same mechanism.
+ */
+declare module '@deepseek-ai/dsh-llm' {
+  interface MessageSourceMap {
+    retry: { kind: 'retry' }
+  }
+}
+
+/** One repair marker found in the current surface, with its original call. */
+interface RetryMarker {
+  /** Seq of the marker `tool/result` event to surface-replace. */
+  resultSeq: number
+  /** Call id recorded on the interrupted call and reused for the re-dispatch. */
+  callId: string
+  /** Original `tool/call` event carrying the exact recorded command. */
+  call: SessionEvent<'tool/call'>
+}
+
+/**
+ * Text written over the repair marker just before re-dispatch. It deliberately
+ * does NOT start with {@link AUTO_RETRY_MARKER}, so a resume that finds it
+ * (because the re-run itself was interrupted) treats the call as already
+ * attempted and never retries it again.
+ */
+const AUTO_RETRY_ATTEMPTED = 'The harness attempted to retry this interrupted tool call, but the retry was itself interrupted.'
+
+/**
+ * Scan the current surface for repair markers left for auto-retryable calls.
+ * A marker is a success-shaped `tool/result` whose text starts with the fixed
+ * auto-retry prefix; the original command comes from the cited `tool/call`.
+ *
+ * @param session - resumed session whose surface is being prepared for a model request.
+ * @returns matched markers in surface order.
+ */
+function findRetryMarkers(session: Session): RetryMarker[] {
+  const markers: RetryMarker[] = []
+  for (const seq of [...session.surface.nodes]) {
+    const event = session.events[seq]
+    if (event?.type !== 'tool/result') continue
+    const first = event.data.message.content[0]
+    if (first?.type !== 'tool-result' || first.isError !== false) continue
+    const text = first.content[0]
+    if (text?.type !== 'text' || !text.text.startsWith(AUTO_RETRY_MARKER)) continue
+    const callSeq = event.sourceEventSeqs?.[0]
+    const call = callSeq === undefined ? undefined : session.events[callSeq]
+    if (call?.type !== 'tool/call') continue
+    markers.push({ resultSeq: seq, callId: event.data.message.source.callId, call })
+  }
+  return markers
+}
+
+/**
+ * Whether the session surface contains a pending auto-retry marker that the
+ * resumed loop should claim. Called from the agent factory's publish step to
+ * decide whether to auto-wake the driver after a cold resume.
+ */
+export function hasPendingAutoRetry(session: Session): boolean {
+  return findRetryMarkers(session).length > 0
+}
+
+/**
+ * Surface-replace one marker with new text, preserving every other field.
+ * Returns the new event seq so a caller can chain a second rewrite.
+ */
+function replaceMarker(
+  session: Session,
+  marker: RetryMarker,
+  text: string,
+): number {
+  const event = session.events[marker.resultSeq]
+  if (event?.type !== 'tool/result') return marker.resultSeq
+  const result = event.data.message.content[0]
+  if (result?.type !== 'tool-result') return marker.resultSeq
+  const message: ToolResultMessage = freezeMessage({
+    ...event.data.message,
+    content: [{
+      ...result,
+      content: [{ type: 'text', text }],
+    }] as [typeof result],
+  })
+  const replacement = session.append('tool/result', {
+    ...event.data,
+    message,
+  }, {
+    surfaceOp: { op: 'replace', start: marker.resultSeq, end: marker.resultSeq },
+    sourceEventSeqs: [marker.resultSeq],
+  })
+  return replacement.seq
+}
+
+/**
+ * Re-dispatch every auto-retryable interrupted call found in the resumed
+ * surface, replacing its repair marker with the re-run result. Each call is
+ * attempted at most once: the marker is rewritten to an un-matchable attempted
+ * state before dispatch, so an interruption during the re-run cannot leave a
+ * retryable marker behind (this is what prevents a retry loop when the
+ * recorded command itself restarts the harness). Failures are surfaced as text
+ * inside the replacement so the model still sees the outcome; a missing tool
+ * or a session that rejects the rewrite leaves the marker so the interruption
+ * stays visible.
+ *
+ * @param ctx - loop context exposing the tool registry and session store.
+ * @param agent - the loop agent on whose behalf the call is re-dispatched.
+ * @param session - resumed session being prepared.
+ * @param signal - caller cancellation for the re-dispatch.
+ */
+export async function autoRetryInterruptedCalls(
+  ctx: Context,
+  agent: Agent,
+  session: Session,
+  signal: AbortSignal,
+): Promise<void> {
+  for (const marker of findRetryMarkers(session)) {
+    // Claim the marker before dispatch: rewrite it to the attempted state so
+    // an interruption during the re-run cannot leave a retryable marker.
+    marker.resultSeq = replaceMarker(session, marker, AUTO_RETRY_ATTEMPTED)
+    signal.throwIfAborted()
+    const exec = {
+      callId: marker.call.data.callId,
+      name: marker.call.data.name,
+      arguments: parseRecordedArguments(marker.call.data.arguments),
+      agent,
+      signal,
+    }
+    let text: string
+    try {
+      const result = await ctx.tools.execute(exec)
+      text = flattenResultText(result.content)
+    } catch (error: unknown) {
+      text = `Automatic retry of the interrupted tool call failed: ${String(error)}`
+    }
+    marker.resultSeq = replaceMarker(session, marker, text)
+  }
+}
+
+/** Parse the recorded JSON argument string, preserving invalid JSON as text. */
+function parseRecordedArguments(raw: string): unknown {
+  try {
+    return raw ? JSON.parse(raw) : {}
+  } catch {
+    return raw
+  }
+}
+
+/** Join a tool result's text blocks into one model-visible string. */
+function flattenResultText(content: readonly { type: string; text?: string }[]): string {
+  const parts: string[] = []
+  for (const block of content) {
+    if (block.type === 'text' && block.text !== undefined) parts.push(block.text)
+  }
+  return parts.length > 0 ? parts.join('\n') : '(no output)'
+}

